# OpenHire Production Environment
# ⚠️ SENSITIVE: Never commit this file to git - add to .gitignore ✓
# This file is for reference only. Set these variables on Render dashboard.

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME=OpenHire Live Interview API
APP_VERSION=0.1.0

# =============================================================================
# INFRASTRUCTURE
# =============================================================================
# Frontend: https://openhire-sable.vercel.app/
# Backend: https://openhire-xc9c.onrender.com
# Database: PostgreSQL on Render (Singapore region)

# =============================================================================
# DATABASE (PRODUCTION - PostgreSQL on Render)
# This IS in use in production (verified directly) - the note that used to
# say "currently using in-memory persistence" was stale. Set on the Render
# dashboard, never committed here.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>
# =============================================================================

# =============================================================================
# CORS (Frontend Integration)
# =============================================================================
CORS_ALLOW_ORIGINS=https://openhire-sable.vercel.app

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# =============================================================================
# LLM PROVIDER (Gemini - what production actually runs, verified directly;
# this section used to say Groq, which is stale/unused)
# =============================================================================
# ⚠️ TODO: Add your Gemini API key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# gemini-2.5-flash (an earlier default here) is retired for newer keys and
# 404s - gemini-3.5-flash-lite is the model verified working in production.
# Re-verify against console.cloud.google.com/vertex-ai/model-garden if this
# 404s again after a key rotation; model availability is account-specific.
GEMINI_MODEL=gemini-3.5-flash-lite

# =============================================================================
# AUDIO PROVIDER (Speech-to-Text)
# =============================================================================
# Option 1: Azure Speech (recommended for production quality)
# AUDIO_PROVIDER=azure
# AZURE_SPEECH_KEY=REPLACE_WITH_YOUR_AZURE_KEY
# AZURE_SPEECH_REGION=eastus

# Option 2: Groq Whisper (uses same API key as LLM)
# AUDIO_PROVIDER=groq

# Option 3: Mock (text-only interviews, no audio)
AUDIO_PROVIDER=mock

# =============================================================================
# TEXT-TO-SPEECH PROVIDER
# =============================================================================
# Option 1: Edge TTS (Free - Microsoft, no API key needed - RECOMMENDED)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# Option 2: Azure Speech (uses same key as audio provider)
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=<from above>
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# Option 3: Mock (text-only)
# TTS_PROVIDER=mock

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Authentication
AUTH_ENABLED=true
AUTH_REQUIRED_BY_DEFAULT=true

# ⚠️ CRITICAL: Generate new secure key for production
# Command: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_32_BYTE_KEY

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LOGGING (Production settings)
# =============================================================================
LOG_LEVEL=INFO
LOG_JSON=true
LOG_ACCESS=true
LOG_QUERY_STRING=false

# =============================================================================
# EMBEDDING CONFIGURATION (Gemini - what production actually runs, verified
# directly; this section used to say a local sentence-transformers model,
# which is stale/unused)
# =============================================================================
EMBEDDING_PROVIDER=gemini
# The only Gemini embedding model verified working against this account/key
# (providers/embeddings/gemini.py) - other model names have 404'd here.
EMBEDDING_MODEL=gemini-embedding-001
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=/data/faiss_index

# =============================================================================
# REQUEST LIMITS
# =============================================================================
MAX_REQUEST_BODY_BYTES=12582912

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000
API_PREFIX=
SERVE_STATIC_PAGES=true
