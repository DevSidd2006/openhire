# OpenHire Production Environment Configuration
# Copy this to .env.production and fill in your actual values
# NEVER commit .env.production to git - it contains secrets

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME=OpenHire Live Interview API
APP_VERSION=0.1.0

# =============================================================================
# LLM PROVIDER (Choose ONE)
# =============================================================================
# Google Gemini (Recommended - verified correct structured extraction)
# gemini-2.5-flash is retired ("no longer available to new users"); its
# successor gemini-3.6-flash took 64-126s on the real resume_parser prompt/
# schema, well past RESUME_PARSER_TIMEOUT_SECONDS (45s). NVIDIA NIM was
# tried first but both available models failed - nemotron-3-ultra-550b-a55b
# (550B) hangs past 45s with no response, and the smaller nemotron-3-
# nano-30b-a3b responds fast but returned a hallucinated, unrelated result
# on the real prompt (not just a JSON error - genuinely wrong data that
# could be mistaken for a real parse). gemini-flash-lite-latest is the
# verified choice: 2.6-4.8s across repeated runs, fully correct output.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Alternative: NVIDIA NIM
# LLM_PROVIDER=nvidia_nim
# NVIDIA_NIM_API_KEY=your_nvidia_api_key_from_build.nvidia.com
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternative: GROQ (fast, affordable, open-source models)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Alternative: OpenAI (GPT-4 level performance)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo

# =============================================================================
# EMBEDDING & VECTOR STORE (API-BASED ONLY - No Large Local Dependencies)
# =============================================================================
# Gemini embeddings (same GEMINI_API_KEY as the LLM provider above) -
# verified locally: gemini-embedding-001 returns 3072-dim vectors.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Alternative: NVIDIA Hosted Embeddings (requires NVIDIA_NIM_API_KEY above)
# EMBEDDING_PROVIDER=nvidia-nim
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Vector store: mock (in-memory, good for Render's memory constraints)
# FAISS not recommended for production on Render (too large)
VECTOR_STORE_TYPE=mock

# =============================================================================
# AUDIO / SPEECH-TO-TEXT PROVIDER (Choose ONE)
# =============================================================================
# Azure Speech (recommended for production speech quality)
AUDIO_PROVIDER=azure
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Alternative: Groq Whisper (uncomment to use)
# AUDIO_PROVIDER=groq
# (reuses GROQ_API_KEY from above)

# Alternative: Keep mock (text-only interviews)
# AUDIO_PROVIDER=mock

# =============================================================================
# TEXT-TO-SPEECH PROVIDER (Choose ONE)
# =============================================================================
# Edge TTS (Free, no API key required - recommended for cost)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# Alternative: Azure Speech (uncomment to use)
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=your_azure_speech_key_here (reuse from above)
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# Alternative: Keep mock (text-only)
# TTS_PROVIDER=mock

# =============================================================================
# DATABASE (REQUIRED for production - data persistence)
# =============================================================================
# PostgreSQL DSN - required for production to persist data across restarts
# Format: postgresql://user:password@host:port/database
# Examples:
#   Local: postgresql://user:password@localhost:5432/openhire
#   AWS RDS: postgresql://user:password@openhire.xxxx.us-east-1.rds.amazonaws.com:5432/openhire
#   Render: postgresql://user:password@dpg-xxxx.render.internal:5432/openhire
#   Railway: postgresql://postgres:password@containers.railway.app:6432/railway
DATABASE_URL=postgresql://user:password@host:5432/openhire

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Enable authentication (required for production)
AUTH_ENABLED=true
AUTH_REQUIRED_BY_DEFAULT=true

# JWT Secret Key - CRITICAL: Generate a secure random key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Min 32 bytes, cryptographically random
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# List your frontend domain(s) - NEVER use wildcard (*) in production
# Format: comma-separated HTTPS URLs
CORS_ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=3600

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_JSON=true
LOG_ACCESS=true
LOG_QUERY_STRING=false

# =============================================================================
# REQUEST LIMITS
# =============================================================================
MAX_REQUEST_BODY_BYTES=12582912

# =============================================================================
# HTTP SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000
API_PREFIX=
SERVE_STATIC_PAGES=true
