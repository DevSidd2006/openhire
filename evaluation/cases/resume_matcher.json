[
  {
    "case_id": "matcher_strong_match",
    "agent": "resume_matcher",
    "description": "Candidate has all required + preferred skills and matching experience.",
    "input": {
      "job": {"job_id": "job_m1", "title": "T", "description": "d", "required_skills": ["Python", "SQL"], "preferred_skills": ["Docker"], "experience_years": 3, "competencies": [{"name": "Python", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m1", "candidate_name": "Strong Match", "skills": ["Python", "SQL", "Docker"], "total_experience_years": 5}
    },
    "expected_behavior": "High match score and shortlist recommended.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "field_in_range", "field": "output.match_score", "min": 0.85, "max": 1.0},
      {"metric": "field_equals", "field": "output.shortlist_recommendation", "value": true},
      {"metric": "length_equals", "field": "output.missing_required_skills", "value": 0}
    ],
    "metadata": {"category": "strong_match"}
  },
  {
    "case_id": "matcher_missing_required_skill",
    "agent": "resume_matcher",
    "description": "Candidate is missing a required skill.",
    "input": {
      "job": {"job_id": "job_m2", "title": "T", "description": "d", "required_skills": ["Python", "Kubernetes"], "preferred_skills": [], "experience_years": 3, "competencies": [{"name": "Python", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m2", "candidate_name": "Partial", "skills": ["Python"], "total_experience_years": 3}
    },
    "expected_behavior": "missing_required_skills reflects the gap; match score reduced accordingly.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "list_contains", "field": "output.missing_required_skills", "value": "Kubernetes"},
      {"metric": "field_in_range", "field": "output.match_score", "min": 0.0, "max": 0.85}
    ],
    "metadata": {"category": "missing_required"}
  },
  {
    "case_id": "matcher_weak_match",
    "agent": "resume_matcher",
    "description": "Candidate matches almost nothing.",
    "input": {
      "job": {"job_id": "job_m3", "title": "T", "description": "d", "required_skills": ["Rust", "Go", "Kubernetes"], "preferred_skills": ["gRPC"], "experience_years": 5, "competencies": [{"name": "Rust", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m3", "candidate_name": "Weak", "skills": ["Excel"], "total_experience_years": 1}
    },
    "expected_behavior": "Low match score, not shortlisted.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "field_in_range", "field": "output.match_score", "min": 0.0, "max": 0.5},
      {"metric": "field_equals", "field": "output.shortlist_recommendation", "value": false}
    ],
    "metadata": {"category": "weak_match"}
  },
  {
    "case_id": "matcher_preferred_only",
    "agent": "resume_matcher",
    "description": "Candidate has preferred skills but is missing required ones.",
    "input": {
      "job": {"job_id": "job_m4", "title": "T", "description": "d", "required_skills": ["Java"], "preferred_skills": ["Docker", "Kubernetes"], "experience_years": 3, "competencies": [{"name": "Java", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m4", "candidate_name": "PreferredOnly", "skills": ["Docker", "Kubernetes"], "total_experience_years": 3}
    },
    "expected_behavior": "Preferred-skill matches alone do not compensate for a missing required skill.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "list_contains", "field": "output.missing_required_skills", "value": "Java"},
      {"metric": "list_not_contains", "field": "output.skill_matches", "value": "Java"}
    ],
    "metadata": {"category": "preferred_only"}
  },
  {
    "case_id": "matcher_overqualified",
    "agent": "resume_matcher",
    "description": "Candidate has far more experience than required.",
    "input": {
      "job": {"job_id": "job_m5", "title": "T", "description": "d", "required_skills": ["Python"], "preferred_skills": [], "experience_years": 2, "competencies": [{"name": "Python", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m5", "candidate_name": "Overqualified", "skills": ["Python"], "total_experience_years": 15}
    },
    "expected_behavior": "Experience match caps rather than growing unbounded with excess experience.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "field_in_range", "field": "output.experience_match", "min": 0.9, "max": 1.0}
    ],
    "metadata": {"category": "overqualified"}
  },
  {
    "case_id": "matcher_monotonic_required_skill",
    "agent": "resume_matcher",
    "description": "Property test: adding a matched required skill must not decrease the match score.",
    "input": {
      "job": {"job_id": "job_m6", "title": "T", "description": "d", "required_skills": ["Python", "SQL", "AWS"], "preferred_skills": [], "experience_years": 3, "competencies": [{"name": "Python", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m6", "candidate_name": "Monotonic", "skills": ["Python"], "total_experience_years": 3},
      "monotonic_check": {"added_required_skill": "SQL"}
    },
    "expected_behavior": "match_score after adding a required skill match is >= before.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "fact_true", "fact": "required_skill_match_non_decreasing"}
    ],
    "metadata": {"category": "monotonic_property"}
  },
  {
    "case_id": "matcher_no_experience_data",
    "agent": "resume_matcher",
    "description": "Resume has no total_experience_years - must not be treated as zero/penalized as a hard fail.",
    "input": {
      "job": {"job_id": "job_m7", "title": "T", "description": "d", "required_skills": ["Python"], "preferred_skills": [], "experience_years": 3, "competencies": [{"name": "Python", "weight": 1.0}]},
      "resume": {"candidate_id": "cand_m7", "candidate_name": "NoExp", "skills": ["Python"], "total_experience_years": null}
    },
    "expected_behavior": "Unknown experience is treated as neutral (0.5), not as a disqualifying zero.",
    "checks": [
      {"metric": "no_error"},
      {"metric": "field_equals", "field": "output.experience_match", "value": 0.5}
    ],
    "metadata": {"category": "missing_experience_data"}
  }
]
