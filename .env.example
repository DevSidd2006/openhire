# Configuration for OpenHire hiring evaluation system
# Copy to .env and configure for your environment

# LLM Provider: "groq" (PRIMARY real provider, P8B.3), "mock" (local
# deterministic regression testing, no API key needed), "openai", or "gemini".
LLM_PROVIDER=mock

# Groq Configuration (only needed if LLM_PROVIDER=groq).
# Groq + openai/gpt-oss-20b is the model OpenHire's agents are developed and
# benchmarked against. Put the real key in .env (gitignored) - NEVER here.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_ORGANIZATION=your_org_id (optional)

# Gemini Configuration (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embedding Provider: "local" (default, uses sentence-transformers) or "openai"
EMBEDDING_PROVIDER=local

# Embedding Model (for local provider)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store: "mock" (default, in-memory) or "faiss" (persistent)
VECTOR_STORE_TYPE=mock

# Audio Processor: "mock" (default) or "azure_speech"
AUDIO_PROCESSOR=mock

# Debug mode (enables verbose logging)
DEBUG=false

# Database/Storage (if using real providers)
# DB_CONNECTION_STRING=postgresql://user:password@localhost/openhire
# AZURE_STORAGE_ACCOUNT_NAME=your_account
# AZURE_STORAGE_ACCOUNT_KEY=your_key

# Output directory (relative to project root)
OUTPUT_DIR=output

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/openhire.log
