# =============================================================================
# OpenHire — Unified Environment Configuration (.env.example)
# Copy this file to .env: cp .env.example .env
#
# Defaults below are configured for local development with mock providers.
# No external API keys or PostgreSQL database are required for the default local setup.
# Production deployments use Gemini LLM & Embeddings, Edge TTS, PostgreSQL, JWT Auth, and Vercel CORS.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# Environment mode: development | test | staging | production
# In "production", the server requires a secure JWT_SECRET_KEY and rejects wildcard CORS.
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000
API_PREFIX=
SERVE_STATIC_PAGES=true

# -----------------------------------------------------------------------------
# 2. LLM PROVIDERS (Choose ONE for LLM_PROVIDER)
# Options: "gemini" (recommended), "nvidia-nim", "groq", "openai", "mock" (offline & free)
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock

# Google Gemini (Recommended - fast, high token budget, verified extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini Live realtime interviews (direct browser audio with a constrained,
# one-use ephemeral token). For the local panel demo, set this to true and
# open http://localhost:8000/app/interview.html?demo=1.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_WRAP_UP_SECONDS=720
GEMINI_LIVE_HARD_STOP_SECONDS=900
GEMINI_LIVE_RECONNECT_SECONDS=540
GEMINI_LIVE_CONTROL_TOKEN_MINUTES=20

# NVIDIA NIM (Alternative cloud provider - fast & high token budget)
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_ENABLE_THINKING=false

# Groq (Fast open-source models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
RESUME_PARSER_TIMEOUT_SECONDS=45

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_ORGANIZATION=your_org_id

# -----------------------------------------------------------------------------
# 3. EMBEDDINGS & VECTOR STORE
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER: "gemini" (hosted API, recommended), "nvidia-nim", "local", "mock"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001

# NVIDIA NIM Embeddings (Alternative hosted API)
# EMBEDDING_PROVIDER=nvidia-nim
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# VECTOR_STORE_TYPE: "mock" (in-memory, default) or "faiss" (persistent local index)
VECTOR_STORE_TYPE=mock
VECTOR_STORE_PATH=faiss_index

# -----------------------------------------------------------------------------
# 4. AUDIO / SPEECH PROCESSING (STT & TTS)
# -----------------------------------------------------------------------------
# Speech-to-Text (STT): "mock" (text-only interviews, default) or "azure"
AUDIO_PROVIDER=mock

# Text-to-Speech (TTS): "edge" (Free neural voice, recommended) or "mock" or "azure"
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# Azure Speech Credentials (required only if AUDIO_PROVIDER=azure or TTS_PROVIDER=azure)
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# -----------------------------------------------------------------------------
# 5. DATABASE / PERSISTENCE
# -----------------------------------------------------------------------------
# Required for persistent production data. Unset uses in-memory stubs (resets on restart).
# Supply a PostgreSQL connection URL. If using docker-compose.postgres.yml:
# DATABASE_URL=postgresql://openhire:openhire@localhost:5432/openhire
DATABASE_URL=

# -----------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY (JWT)
# -----------------------------------------------------------------------------
# AUTH_ENABLED=false serves all requests as anonymous principal (development default).
# In production, set AUTH_ENABLED=true and supply a secure JWT_SECRET_KEY.
AUTH_ENABLED=false
AUTH_REQUIRED_BY_DEFAULT=false

# CRITICAL FOR PRODUCTION: Generate with python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secure_random_32_byte_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 7. CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Leave empty for same-origin (when pages/ is served by FastAPI).
# For external frontends (e.g. Vercel deployment), specify comma-separated origins.
# NEVER use wildcard (*) in production.
CORS_ALLOW_ORIGINS=https://openhire-public.vercel.app
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_MAX_AGE=600

# -----------------------------------------------------------------------------
# 8. BRING YOUR OWN KEY (BYOK) ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte urlsafe base64 Fernet key used to encrypt candidate-provided API keys at rest.
# Optional: if unset, BYOK endpoints remain disabled.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 9. LOGGING & SAFETY LIMITS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/openhire.log
LOG_JSON=true
LOG_ACCESS=true
LOG_QUERY_STRING=false

MAX_REQUEST_BODY_BYTES=12582912
MAX_UTTERANCE_BYTES=10485760
MIN_TRANSCRIPT_CHARS=2
