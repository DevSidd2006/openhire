# Configuration for OpenHire hiring evaluation system
# Copy to .env and configure for your environment

# LLM Provider: "nvidia-nim" (PRIMARY real provider), "mock" (local
# deterministic regression testing, no API key needed), "openai", "groq", or "gemini".
LLM_PROVIDER=mock

# NVIDIA NIM Configuration (needed if LLM_PROVIDER=nvidia-nim)
NVIDIA_NIM_API_KEY=your_nvidia_api_key_from_build.nvidia.com
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq Configuration (only needed if LLM_PROVIDER=groq, deprecated - use nvidia-nim)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_ORGANIZATION=your_org_id (optional)

# Gemini Configuration (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embedding Provider (choose one)
# "nvidia-nim" - Free hosted API (nemotron-3-embed-1b), no local dependencies (recommended)
# "local" - Uses sentence-transformers locally (requires large model download)
# "mock" - Dummy embeddings for testing
EMBEDDING_PROVIDER=nvidia-nim
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Vector Store
# "mock" - In-memory, good for Render (no persistence between restarts)
# "faiss" - Persistent local index (requires large faiss library)
VECTOR_STORE_TYPE=mock

# Audio Processor: "mock" (default) or "azure_speech"
AUDIO_PROCESSOR=mock

# Debug mode (enables verbose logging)
DEBUG=false

# PostgreSQL (repositories/postgres/). Unset (the default) means the backend
# runs on temporary in-memory storage (repositories/memory.py) - data does
# NOT survive a restart. Set this to enable durable PostgreSQL persistence;
# apply repositories/postgres/schema.sql to the target database first.
# DATABASE_URL=postgresql://user:password@localhost:5432/openhire

# Database/Storage (if using real providers)
# AZURE_STORAGE_ACCOUNT_NAME=your_account
# AZURE_STORAGE_ACCOUNT_KEY=your_key

# Output directory (relative to project root)
OUTPUT_DIR=output

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/openhire.log

# ===========================================================================
# Backend service configuration (Chunk 1)
#
# Everything above configures the DOMAIN (which model, which speech
# provider). Everything below configures the SERVICE itself and is read by
# core/config.py. The two never redeclare the same value.
# ===========================================================================

# Deployment environment: development | test | staging | production.
# "production" additionally REFUSES to start on a wildcard CORS origin, on
# DEBUG=true, and while the temporary in-memory repositories are still in
# use (see repositories/memory.py) - all three are silent data-loss or
# security failures rather than degraded modes.
ENVIRONMENT=development

# Bind address for uvicorn. PORT is what most PaaS platforms inject.
HOST=0.0.0.0
PORT=8000

# Optional path prefix for every API route, e.g. "/api/v1". Empty by
# default and should STAY empty unless the frontend is updated in the same
# change: the existing clients and pages/voice-interview.html call
# /sessions and /ws/sessions/{id} directly.
API_PREFIX=

# Serve pages/ from the API's own origin at /app. Keep on unless a separate
# static host is serving the voice client.
SERVE_STATIC_PAGES=true

# --- CORS -----------------------------------------------------------------
# OFF by default: no CORS middleware is installed at all unless an origin is
# configured here. The API and the shipped voice client are same-origin, so
# cross-origin access is something you opt into - never something that is on
# by accident.
# Comma-separated exact origins. "*" is rejected in production, and is
# rejected in ANY environment when combined with credentials (browsers
# refuse that pair, so allowing it would ship auth that silently never works).
CORS_ALLOW_ORIGINS=
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.yourfrontend\.com
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_MAX_AGE=600

# --- Logging --------------------------------------------------------------
# LOG_LEVEL is already defined further up; these control the service's
# formatting. LOG_JSON=true emits one JSON object per line for aggregation.
LOG_JSON=false
LOG_ACCESS=true
# Query strings are a common place for tokens to leak into log files, so
# they are omitted from the access line unless you turn this on.
LOG_QUERY_STRING=false

# --- Authentication boundary ---------------------------------------------
# Chunk 1 ships the BOUNDARY (Principal, AuthProvider, the endpoint
# dependencies), not an auth system - a real one needs the database schema
# another teammate owns. With AUTH_ENABLED=false every request is served as
# the anonymous principal, which is exactly the current behaviour.
#
# Setting AUTH_ENABLED=true without installing a real AuthProvider in
# core/container.py makes the service REFUSE TO START. That is deliberate:
# "authentication is on" must never be a claim the service cannot honour.
AUTH_ENABLED=false
AUTH_REQUIRED_BY_DEFAULT=false

# --- Limits ---------------------------------------------------------------
# Outer bound on request bodies, rejected at the edge before buffering.
# The voice endpoints accept base64 audio; MAX_UTTERANCE_BYTES (domain-level,
# on decoded audio) still applies and is unchanged - this is defence in depth.
MAX_REQUEST_BODY_BYTES=12582912
