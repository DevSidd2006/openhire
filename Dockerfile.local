# OpenHire — Local Development Dockerfile
#
# Used by docker-compose.yml to run the FastAPI app locally with
# the same codebase as the cloud deployment.
#
# Build:
#   docker build -f Dockerfile.local -t openhire-local .
#
FROM python:3.13-slim

WORKDIR /app/openhire

# System deps for asyncpg / cryptography / pypdf / python-docx / pymupdf
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY . .

# Default command: run the API with uvicorn
CMD ["python", "-m", "uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
